{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormTray",
  "version": "0.16.2",
  "identifier": "ai.nodemode.formtray",
  "build": {
    "devUrl": "http://localhost:5610",
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: appicon: http://appicon.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src formext: http://formext.localhost"
    },
    "windows": [
      { "label": "splash", "title": "FormTray", "url": "splash.html", "width": 360, "height": 200, "resizable": false, "decorations": false, "center": true, "transparent": true, "shadow": false, "visible": false },
      { "label": "panel", "title": "FormTray", "url": "index.html?view=apps", "width": 920, "height": 660, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "shadow": true, "focus": true },
      { "label": "prefs", "title": "FormTray Settings", "url": "index.html?view=prefs", "width": 640, "height": 600, "visible": false, "decorations": false, "transparent": true, "alwaysOnTop": false, "skipTaskbar": false, "resizable": false, "shadow": true, "focus": true, "center": true }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "One dock icon for every Form app",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE.md": "NOTICE.md" },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
