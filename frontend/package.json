{
  "name": "formtray",
  "private": true,
  "version": "0.14.3",
  "description": "FormTray's interface: one dock icon for every Form app",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:demo": "tsc -p ../demo --noEmit && vite build --config ../demo/vite.config.ts",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
